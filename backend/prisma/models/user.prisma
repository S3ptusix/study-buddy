// ============================================================================
// 5. Users
// ============================================================================

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

model User {
  id            String   @id @default(uuid())
  username      String   @unique
  email         String   @unique
  passwordHash  String   @map("password_hash")
  displayName   String?  @map("display_name")
  avatarUrl     String?  @map("avatar_url")
  bio           String?
  role          Role     @default(STUDENT)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  emailVerified Boolean  @default(false)

  // Social
  posts     Post[]
  comments  Comment[]
  postLikes PostLike[]
  postSaves PostSave[]

  // Materials / Reviewers / Quizzes owned by this user
  materials    Material[]
  reviewers    Reviewer[]
  quizzes      Quiz[]
  quizAttempts QuizAttempt[]

  // Classrooms
  classroomsTaught     Classroom[]       @relation("ClassroomTeacher")
  classroomMemberships ClassroomMember[]

  // Assignments
  assignmentsCreated    Assignment[]           @relation("AssignmentCreator")
  assignmentSubmissions AssignmentSubmission[]

  // Groups
  groupsOwned      Group[]       @relation("GroupOwner")
  groupMemberships GroupMember[]

  // Chat
  messagesSent Message[]

  // AI jobs
  aiJobs AiJob[]

  @@map("users")
}
