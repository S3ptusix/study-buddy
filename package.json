{
  "dependencies": {
    "concurrently": "^10.0.5"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:studio\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:studio": "cd backend && npx prisma studio"
  }
}